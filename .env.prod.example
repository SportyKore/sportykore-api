# Production — copy to .env.prod for smoke tests, or set as host/env vars.
# Deploy: build Dockerfile production target; migrations run on container start.

# Node (Cloud Run sets PORT=8080 automatically)
TZ=UTC
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=https://your-service-xxxxx.run.app
PUBLIC_WEB_URL=https://join.sportykore.com
SECRET_SANTA_PASSWORD=

# Session
SESSION_DRIVER=cookie

# Google OAuth (optional — routes currently disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOBILE_OAUTH_DEEP_LINK=sportykore://auth/callback
MOBILE_APP_URL=sportykore://
EXPO_PUSH_ACCESS_TOKEN=

# File storage — Amazon S3
DRIVE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET=
S3_CDN_URL=https://media.sportykore.com

# Database (Neon / managed Postgres)
DB_CONNECTION=pg
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=true

# Mail — resend or ses (MAIL_MAILER selects the active mailer in config/mail.ts)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=app@notifications.sportykore.com
MAIL_FROM_NAME=Sportykore
RESEND_API_KEY=
# SES (when MAIL_MAILER=ses)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Redis (Upstash) — rate limiting + Transmit SSE backplane across Cloud Run instances
LIMITER_STORE=redis
REDIS_HOST=your-upstash-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true

# Store reviewer OTP bypass + DemoSeeder (see docs/REVIEWER_ACCESS.md)
# REVIEW_ACCOUNT_ENABLED=true
# REVIEW_ADMIN_EMAIL=review-admin@sportykore.com
# REVIEW_PLAYER_EMAIL=review-player@sportykore.com
# REVIEW_OTP_CODE=424242
# ALLOW_DEMO_SEED is set in the production Dockerfile seed step; optional here too.

# Google Sheets support (FAQ / bug reports)
# Prefer email + private key — Node --env-file truncates multi-line JSON to "{".
# SUPPORT_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_FAQ_NAME=FAQ
# GOOGLE_SHEETS_BUGS_NAME=Bug
# GOOGLE_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or single-line JSON (no line breaks): GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
