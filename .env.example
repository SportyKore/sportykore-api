# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333
# Public join/claim pages. Unset locally (falls back to APP_URL).
# PUBLIC_WEB_URL=https://join.sportykore.com
SECRET_SANTA_PASSWORD=

# Session
SESSION_DRIVER=cookie

# Google OAuth (optional — mobile OAuth routes are currently disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOBILE_OAUTH_DEEP_LINK=

# ── File storage (Adonis Drive) ─────────────────────────────
# fs = local storage/ + /uploads (default for local dev)
# s3 = Amazon S3 (production default)
# gcs = Google Cloud Storage (optional)
DRIVE_DISK=fs

# S3 (when DRIVE_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-2
# S3_BUCKET=
# S3_CDN_URL=https://media.sportykore.com

# GCS (when DRIVE_DISK=gcs)
# GCS_BUCKET=your-project-uploads
# GCS_KEY=file://gcs_key.json

# ── Database ────────────────────────────────────────────────
# sqlite = local file (tmp/db.sqlite3). pg = Postgres (Docker dev / Neon prod).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=sportykore
# DB_PASSWORD=
# DB_DATABASE=sportykore_dev
# DB_SSL=false

# Mail — resend (default) or ses
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=app@yourdomain.com
MAIL_FROM_NAME=Sportykore
RESEND_API_KEY=
# SES (when MAIL_MAILER=ses)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Mobile app deep link base URL (e.g. sportykore:// in prod)
MOBILE_APP_URL=

# Expo Push Notifications (optional, only needed if your Expo account requires access tokens)
EXPO_PUSH_ACCESS_TOKEN=

# Rate limiting + Transmit SSE backplane
# memory = in-process (single instance). redis = required for multi-instance prod.
LIMITER_STORE=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# App Store / Play Store reviewer OTP bypass (optional — see docs/REVIEWER_ACCESS.md)
# REVIEW_ACCOUNT_ENABLED=true
# REVIEW_ADMIN_EMAIL=review-admin@sportykore.com
# REVIEW_PLAYER_EMAIL=review-player@sportykore.com
# REVIEW_OTP_CODE=424242
# ALLOW_DEMO_SEED=true